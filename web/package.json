{
  "name": "koplik-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "fixtures": "node scripts/build-synthetic-fixtures.mjs",
    "dev": "vite",
    "dev:synthetic": "npm run fixtures && VITE_SYNTHETIC_FIXTURES=1 vite",
    "build": "npm run check:types && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run check:types && vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "maplibre-gl": "^5.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
