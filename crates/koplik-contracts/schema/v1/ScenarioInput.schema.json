{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioInput",
  "description": "Everything needed to reproduce an ensemble: same input, same seed, same trajectories.",
  "type": "object",
  "properties": {
    "coverage_overrides": {
      "description": "Coverage replacements; geographies not listed use their measured baseline.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoverageOverride"
      }
    },
    "geographies": {
      "description": "Geographies simulated (non-empty, no duplicates).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/GeoId"
      }
    },
    "initial_infections": {
      "description": "Initial infectious counts per geography.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/InitialInfection"
      }
    },
    "parameters": {
      "$ref": "#/$defs/SeirParameters"
    },
    "run_count": {
      "description": "Number of ensemble members (at least 1).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "seed": {
      "description": "RNG seed. Run `k` derives its own seed from this and `k`.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "start_week": {
      "description": "Week the simulation starts.",
      "$ref": "#/$defs/MmwrWeek"
    }
  },
  "additionalProperties": false,
  "required": [
    "geographies",
    "start_week",
    "coverage_overrides",
    "initial_infections",
    "parameters",
    "seed",
    "run_count"
  ],
  "$defs": {
    "CoverageOverride": {
      "description": "Replace a geography's baseline kindergarten MMR coverage in a what-if run.",
      "type": "object",
      "properties": {
        "coverage_pct": {
          "description": "Coverage percent, 0 to 100.",
          "type": "number",
          "format": "double",
          "maximum": 100,
          "minimum": 0
        },
        "geography": {
          "$ref": "#/$defs/GeoId"
        }
      },
      "additionalProperties": false,
      "required": [
        "geography",
        "coverage_pct"
      ]
    },
    "GeoId": {
      "description": "Geography key: state FIPS (2 digits) or county FIPS (5 digits), zero-padded",
      "type": "string",
      "pattern": "^((0[1-9]|[1-9][0-9])|(0[1-9]|[1-9][0-9])(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))$"
    },
    "GravityParameters": {
      "description": "Gravity-model coupling between geographies: flow from i to j is\n`scale * pop_i^origin_exponent * pop_j^destination_exponent / distance_km^distance_exponent`.",
      "type": "object",
      "properties": {
        "destination_exponent": {
          "type": "number",
          "format": "double"
        },
        "distance_exponent": {
          "type": "number",
          "format": "double"
        },
        "origin_exponent": {
          "type": "number",
          "format": "double"
        },
        "scale": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "scale",
        "origin_exponent",
        "destination_exponent",
        "distance_exponent"
      ]
    },
    "InitialInfection": {
      "description": "Infectious individuals placed in a geography at the start week.",
      "type": "object",
      "properties": {
        "geography": {
          "$ref": "#/$defs/GeoId"
        },
        "infectious": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "geography",
        "infectious"
      ]
    },
    "MmwrWeek": {
      "description": "An MMWR year and week number (`week` is `1..=52` or `1..=53`).",
      "type": "object",
      "properties": {
        "week": {
          "description": "Week of the MMWR year; 1 to 52, or 53 in a 53-week year.",
          "type": "integer",
          "format": "uint8",
          "maximum": 53,
          "minimum": 1
        },
        "year": {
          "description": "MMWR year (not always the calendar year of every day in the week).",
          "type": "integer",
          "format": "uint16",
          "maximum": 2200,
          "minimum": 1900
        }
      },
      "additionalProperties": false,
      "required": [
        "year",
        "week"
      ]
    },
    "SeirParameters": {
      "description": "Full SEIR parameter set. Every value is configurable; none is hard-coded in the engine.",
      "type": "object",
      "properties": {
        "gravity": {
          "description": "Coupling between geographies; `null` runs each geography in isolation.",
          "anyOf": [
            {
              "$ref": "#/$defs/GravityParameters"
            },
            {
              "type": "null"
            }
          ]
        },
        "horizon_days": {
          "description": "Simulated horizon in days.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "infectious_period_days": {
          "description": "Mean infectious period in days.",
          "type": "number",
          "format": "double"
        },
        "latent_period_days": {
          "description": "Mean latent (exposed, not yet infectious) period in days.",
          "type": "number",
          "format": "double"
        },
        "mmr_effectiveness_one_dose": {
          "description": "Protection from one MMR dose, in [0, 1].",
          "type": "number",
          "format": "double"
        },
        "mmr_effectiveness_two_doses": {
          "description": "Protection from two MMR doses, in [0, 1]; applied to kindergarten MMR coverage.",
          "type": "number",
          "format": "double"
        },
        "r0": {
          "description": "Basic reproduction number R0 in a fully susceptible population.",
          "type": "number",
          "format": "double"
        },
        "time_step_days": {
          "description": "Tau-leap step length in days.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "r0",
        "latent_period_days",
        "infectious_period_days",
        "mmr_effectiveness_one_dose",
        "mmr_effectiveness_two_doses",
        "time_step_days",
        "horizon_days"
      ]
    }
  }
}
