{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioInput",
  "description": "Everything needed to reproduce an ensemble: same input, same seed, same trajectories.\nIt is self-contained: the engine needs nothing else (no data lookups).",
  "type": "object",
  "properties": {
    "coverage_overrides": {
      "description": "Coverage replacements (what-if slider); each names a node and appears at most once.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoverageOverride"
      }
    },
    "nodes": {
      "description": "Simulated geographies: non-empty, unique, in canonical order (`GeoId` order: states\nby FIPS code, then counties by FIPS code), so output order never depends on input order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioNode"
      }
    },
    "parameters": {
      "$ref": "#/$defs/SeirParameters"
    },
    "run_count": {
      "description": "Number of ensemble members (at least 1).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "seed": {
      "description": "RNG seed. Run `k` derives its own seed from this and `k`.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "start_week": {
      "description": "Week the simulation starts.",
      "$ref": "#/$defs/MmwrWeek"
    }
  },
  "additionalProperties": false,
  "required": [
    "nodes",
    "start_week",
    "coverage_overrides",
    "parameters",
    "seed",
    "run_count"
  ],
  "$defs": {
    "BaselineCoverage": {
      "description": "Baseline kindergarten MMR coverage of a node, or an explicit missing value. A node with\nmissing coverage is only valid when a `coverage_overrides` entry supplies its value.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "coverage_pct": {
              "description": "Coverage percent, 0 to 100.",
              "type": "number",
              "format": "double",
              "maximum": 100,
              "minimum": 0
            },
            "imputed": {
              "description": "True when the value was imputed rather than measured.",
              "type": "boolean"
            },
            "provenance": {
              "$ref": "#/$defs/Provenances"
            },
            "status": {
              "type": "string",
              "const": "reported"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "coverage_pct",
            "imputed",
            "provenance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/MissingReason"
            },
            "status": {
              "type": "string",
              "const": "missing"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "Centroid": {
      "description": "A point on the WGS84 ellipsoid in decimal degrees (e.g. a county's population or\ngeometric centroid; the source states which in its provenance).",
      "type": "object",
      "properties": {
        "latitude": {
          "description": "Degrees north, -90 to 90.",
          "type": "number",
          "format": "double",
          "maximum": 90,
          "minimum": -90
        },
        "longitude": {
          "description": "Degrees east, -180 to 180.",
          "type": "number",
          "format": "double",
          "maximum": 180,
          "minimum": -180
        }
      },
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "CoverageOverride": {
      "description": "Replace a geography's baseline kindergarten MMR coverage in a what-if run.",
      "type": "object",
      "properties": {
        "coverage_pct": {
          "description": "Coverage percent, 0 to 100.",
          "type": "number",
          "format": "double",
          "maximum": 100,
          "minimum": 0
        },
        "geography": {
          "$ref": "#/$defs/GeoId"
        }
      },
      "additionalProperties": false,
      "required": [
        "geography",
        "coverage_pct"
      ]
    },
    "GeoId": {
      "description": "Geography key: state FIPS (2 digits) or county FIPS (5 digits), zero-padded",
      "type": "string",
      "pattern": "^((0[1-9]|[1-9][0-9])|(0[1-9]|[1-9][0-9])(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))$"
    },
    "GravityParameters": {
      "description": "Gravity-model coupling between geographies: flow from i to j is\n`scale * pop_i^origin_exponent * pop_j^destination_exponent / distance_km^distance_exponent`.",
      "type": "object",
      "properties": {
        "destination_exponent": {
          "type": "number",
          "format": "double"
        },
        "distance_exponent": {
          "type": "number",
          "format": "double"
        },
        "origin_exponent": {
          "type": "number",
          "format": "double"
        },
        "scale": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "scale",
        "origin_exponent",
        "destination_exponent",
        "distance_exponent"
      ]
    },
    "MissingReason": {
      "description": "Why a weekly count is missing.",
      "oneOf": [
        {
          "description": "The source did not report this geography and week.",
          "type": "string",
          "const": "not_reported"
        },
        {
          "description": "The source withheld the value (small-number suppression).",
          "type": "string",
          "const": "suppressed"
        },
        {
          "description": "The source has the week but the value could not be read unambiguously.",
          "type": "string",
          "const": "ambiguous"
        }
      ]
    },
    "MmwrWeek": {
      "description": "An MMWR year and week number (`week` is `1..=52` or `1..=53`).",
      "type": "object",
      "properties": {
        "week": {
          "description": "Week of the MMWR year; 1 to 52, or 53 in a 53-week year.",
          "type": "integer",
          "format": "uint8",
          "maximum": 53,
          "minimum": 1
        },
        "year": {
          "description": "MMWR year (not always the calendar year of every day in the week).",
          "type": "integer",
          "format": "uint16",
          "maximum": 2200,
          "minimum": 1900
        }
      },
      "additionalProperties": false,
      "required": [
        "year",
        "week"
      ]
    },
    "Provenance": {
      "description": "Where a number came from: the immutable snapshot, its source URL and when it was retrieved.",
      "type": "object",
      "properties": {
        "licence_id": {
          "description": "Id of the source's licence or terms as listed in `SOURCES.md`.",
          "type": "string"
        },
        "retrieved_at": {
          "description": "Retrieval time, RFC 3339 in UTC (e.g. `2026-09-30T12:00:00Z`).",
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "description": "Content address of the raw snapshot bytes.",
          "$ref": "#/$defs/Sha256Hex"
        },
        "source_id": {
          "description": "Stable id of the source as listed in `SOURCES.md` (e.g. `cdc-measles-weekly`).",
          "type": "string"
        },
        "url": {
          "description": "URL the snapshot was retrieved from.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "retrieved_at",
        "sha256",
        "licence_id"
      ]
    },
    "Provenances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "minItems": 1
    },
    "R0": {
      "description": "Basic reproduction number R0 in a fully susceptible population: a fixed value, or a\nuniform prior that the engine samples once per ensemble member (uniform on `[min, max]`,\ndrawn from that member's derived seed before its first step). The sampling lives in\n`koplik-epi`; this type only states the choice, so a scenario is reproducible from its\nseed. E.g. the spec's R0 prior of 12 to 18 is `uniform_prior { min: 12, max: 18 }`.",
      "oneOf": [
        {
          "description": "Every member uses this value (`value > 0`).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Each member draws its own R0 uniformly from `[min, max]` (`0 < min <= max`).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_prior"
            },
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "min",
            "max"
          ]
        }
      ]
    },
    "ScenarioNode": {
      "description": "One simulated geography with everything the engine needs about it.",
      "type": "object",
      "properties": {
        "baseline_coverage": {
          "$ref": "#/$defs/BaselineCoverage"
        },
        "centroid": {
          "description": "Location used for gravity coupling.",
          "$ref": "#/$defs/Centroid"
        },
        "id": {
          "$ref": "#/$defs/GeoId"
        },
        "initial_exposed": {
          "description": "Exposed (latent) individuals at the start week.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "initial_infectious": {
          "description": "Infectious individuals at the start week. Exposed plus infectious must not exceed\nthe population.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "population": {
          "description": "Resident population (`> 0`).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "population",
        "baseline_coverage",
        "centroid",
        "initial_exposed",
        "initial_infectious"
      ]
    },
    "SeirParameters": {
      "description": "Full SEIR parameter set. Every value is configurable; none is hard-coded in the engine.",
      "type": "object",
      "properties": {
        "gravity": {
          "description": "Coupling between geographies; `null` runs each geography in isolation.",
          "anyOf": [
            {
              "$ref": "#/$defs/GravityParameters"
            },
            {
              "type": "null"
            }
          ]
        },
        "horizon_days": {
          "description": "Simulated horizon in days.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "infectious_period_days": {
          "description": "Mean infectious period in days.",
          "type": "number",
          "format": "double"
        },
        "latent_period_days": {
          "description": "Mean latent (exposed, not yet infectious) period in days.",
          "type": "number",
          "format": "double"
        },
        "mmr_effectiveness_one_dose": {
          "description": "Protection from one MMR dose, in [0, 1].",
          "type": "number",
          "format": "double"
        },
        "mmr_effectiveness_two_doses": {
          "description": "Protection from two MMR doses, in [0, 1]; applied to kindergarten MMR coverage.",
          "type": "number",
          "format": "double"
        },
        "r0": {
          "description": "Basic reproduction number R0: fixed, or a prior sampled once per ensemble member.",
          "$ref": "#/$defs/R0"
        },
        "time_step_days": {
          "description": "Tau-leap step length in days.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "r0",
        "latent_period_days",
        "infectious_period_days",
        "mmr_effectiveness_one_dose",
        "mmr_effectiveness_two_doses",
        "time_step_days",
        "horizon_days"
      ]
    },
    "Sha256Hex": {
      "description": "SHA-256 digest, 64 lowercase hex characters",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
