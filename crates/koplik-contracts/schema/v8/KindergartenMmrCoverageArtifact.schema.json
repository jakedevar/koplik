{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KindergartenMmrCoverageArtifact",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "integer",
      "const": 6
    },
    "provenance": {
      "type": "array",
      "items": {
        "title": "Provenance",
        "description": "Where a number came from: the immutable snapshot, its source URL and when it was retrieved.",
        "type": "object",
        "properties": {
          "licence_id": {
            "description": "Id of the source's licence or terms as listed in `SOURCES.md`.",
            "type": "string"
          },
          "retrieved_at": {
            "description": "Retrieval time, RFC 3339 in UTC (e.g. `2026-09-30T12:00:00Z`).",
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "description": "Content address of the raw snapshot bytes.",
            "$ref": "#/$defs/Sha256Hex"
          },
          "source_id": {
            "description": "Stable id of the source as listed in `SOURCES.md` (e.g. `cdc-measles-weekly`).",
            "type": "string"
          },
          "url": {
            "description": "URL the snapshot was retrieved from.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "source_id",
          "url",
          "retrieved_at",
          "sha256",
          "licence_id"
        ]
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "title": "KindergartenMmrCoverage",
        "description": "Kindergarten MMR vaccination coverage for a geography and school year.",
        "type": "object",
        "properties": {
          "coverage": {
            "$ref": "#/$defs/CoverageValue"
          },
          "geography": {
            "$ref": "#/$defs/GeoId"
          },
          "imputation_method": {
            "description": "Non-empty description of the imputation method when `imputed`; `null` otherwise.",
            "type": [
              "string",
              "null"
            ]
          },
          "imputed": {
            "description": "True when the reported value was filled in by a method rather than measured.\nNever true for a missing value.",
            "type": "boolean"
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0
            },
            "minItems": 1
          },
          "school_year": {
            "$ref": "#/$defs/SchoolYear"
          }
        },
        "additionalProperties": false,
        "required": [
          "geography",
          "school_year",
          "coverage",
          "imputed",
          "provenance"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "contract_version",
    "provenance",
    "rows"
  ],
  "$defs": {
    "CoverageValue": {
      "description": "A kindergarten MMR coverage value that can be explicitly missing. `reported` with\n`coverage_pct: 0` is a real zero; `missing` is unknown. They are never interchangeable.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "coverage_pct": {
              "description": "Percent of kindergartners with the MMR series, 0 to 100.",
              "type": "number",
              "format": "double",
              "maximum": 100,
              "minimum": 0
            },
            "exemption_pct": {
              "description": "Percent with any exemption, 0 to 100; `null` when the source does not report it.",
              "type": [
                "number",
                "null"
              ],
              "format": "double",
              "maximum": 100,
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "reported"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "coverage_pct"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/MissingReason"
            },
            "status": {
              "type": "string",
              "const": "missing"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "GeoId": {
      "description": "Geography key: state FIPS (2 digits) or county FIPS (5 digits), zero-padded",
      "type": "string",
      "pattern": "^((0[1-9]|[1-9][0-9])|(0[1-9]|[1-9][0-9])(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))$"
    },
    "MissingReason": {
      "description": "Why a weekly count is missing.",
      "oneOf": [
        {
          "description": "The source did not report this geography and week.",
          "type": "string",
          "const": "not_reported"
        },
        {
          "description": "The source withheld the value (small-number suppression).",
          "type": "string",
          "const": "suppressed"
        },
        {
          "description": "The source has the week but the value could not be read unambiguously.",
          "type": "string",
          "const": "ambiguous"
        }
      ]
    },
    "Provenance": {
      "description": "Where a number came from: the immutable snapshot, its source URL and when it was retrieved.",
      "type": "object",
      "properties": {
        "licence_id": {
          "description": "Id of the source's licence or terms as listed in `SOURCES.md`.",
          "type": "string"
        },
        "retrieved_at": {
          "description": "Retrieval time, RFC 3339 in UTC (e.g. `2026-09-30T12:00:00Z`).",
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "description": "Content address of the raw snapshot bytes.",
          "$ref": "#/$defs/Sha256Hex"
        },
        "source_id": {
          "description": "Stable id of the source as listed in `SOURCES.md` (e.g. `cdc-measles-weekly`).",
          "type": "string"
        },
        "url": {
          "description": "URL the snapshot was retrieved from.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "retrieved_at",
        "sha256",
        "licence_id"
      ]
    },
    "Provenances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "minItems": 1
    },
    "SchoolYear": {
      "description": "School year, e.g. 2023-24 (second part is the next year mod 100)",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "Sha256Hex": {
      "description": "SHA-256 digest, 64 lowercase hex characters",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
